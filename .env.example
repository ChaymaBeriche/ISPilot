# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# These are used only by the local demo stack; there are no external API keys.

# MySQL / FreeRADIUS database
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_USER=radius
MYSQL_PASSWORD=CHANGE_ME_radius_password
MYSQL_DB=radius

# Shared secret between FreeRADIUS and its clients (NAS)
RADIUS_CLIENT_SECRET=CHANGE_ME_radius_client_secret

# GenieACS UI session-signing secret (use a long random string)
GENIEACS_UI_JWT_SECRET=CHANGE_ME_long_random_string

# Local LLM served by Ollama (pull it once: docker exec -it ollama ollama pull <model>)
OLLAMA_MODEL=qwen2.5:14b
